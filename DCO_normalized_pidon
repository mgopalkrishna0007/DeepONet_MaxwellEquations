class DCO_Trainer:
    """Handles model training and evaluation with normalized targets"""
    
    def __init__(self, model: nn.Module, config: Config):
        self.model = model
        self.config = config
        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
        self.model.to(self.device)
        
        # Optimizer and loss (MSE only during training on NORMALIZED curl)
        self.optimizer = optim.Adam(model.parameters(), lr=config.LEARNING_RATE)
        self.criterion = nn.MSELoss()
        
        # Training history
        self.history = {
            'train_loss': [],
            'test_loss': [],
            'epoch': []
        }
        
        print(f"Using device: {self.device}")
    
    def compute_test_loss(self, test_loader: DataLoader) -> float:
        """Compute test loss (MSE on NORMALIZED curl)"""
        self.model.eval()
        total_loss = 0.0
        total_batches = 0
        
        with torch.no_grad():
            for batch in test_loader:
                E_field, cell_sizes, _, curl_norm_target, _, _ = batch
                
                E_field = E_field.to(self.device)
                cell_sizes = cell_sizes.to(self.device)
                curl_norm_target = curl_norm_target.to(self.device)
                
                # Model outputs raw curl
                outputs_raw = self.model(E_field, cell_sizes)
                
                # Normalize model output for loss computation
                outputs_norm, _ = LocalMaxNormalizer3D.normalize_tensor_with_scale(outputs_raw)
                
                # Compute MSE on normalized curl
                loss = self.criterion(outputs_norm, curl_norm_target)
                
                total_loss += loss.item()
                total_batches += 1
        
        return total_loss / total_batches if total_batches > 0 else 0.0
    
    def train_epoch(self, train_loader: DataLoader) -> float:
        """Train for one epoch (MSE on NORMALIZED curl)"""
        self.model.train()
        total_loss = 0.0
        total_batches = 0
        
        for batch in train_loader:
            E_field, cell_sizes, _, curl_norm_target, _, _ = batch
            
            E_field = E_field.to(self.device)
            cell_sizes = cell_sizes.to(self.device)
            curl_norm_target = curl_norm_target.to(self.device)
            
            self.optimizer.zero_grad()
            
            # Forward pass - model outputs raw curl
            outputs_raw = self.model(E_field, cell_sizes)
            
            # Normalize model output for training loss
            outputs_norm, _ = LocalMaxNormalizer3D.normalize_tensor_with_scale(outputs_raw)
            
            # Compute MSE loss on NORMALIZED curl
            loss = self.criterion(outputs_norm, curl_norm_target)
            
            # Backward pass
            loss.backward()
            self.optimizer.step()
            
            total_loss += loss.item()
            total_batches += 1
        
        return total_loss / total_batches if total_batches > 0 else 0.0
    
    def train(self, train_loader: DataLoader, test_loader: DataLoader, 
              epochs: int = Config.EPOCHS) -> Dict[str, List[float]]:
        """
        Main training loop with 80/20 train-test only.
        Training uses MSE on NORMALIZED curl.
        """
        print(f"\n{'='*60}")
        print(f"Starting training for {epochs} epochs")
        print(f"Training samples: {len(train_loader.dataset)}")
        print(f"Test samples: {len(test_loader.dataset)}")
        print(f"Learning rate: {self.config.LEARNING_RATE}")
        print(f"Batch size: {self.config.BATCH_SIZE}")
        print(f"Training on NORMALIZED curl (MSE loss)")
        print(f"{'='*60}\n")
        
        best_test_loss = float('inf')
        
        # Header for epoch progress
        print(f"{'Epoch':^8} | {'Train Loss':^12} | {'Test Loss':^12} | {'Status':^10}")
        print(f"{'-'*8}+{'-'*14}+{'-'*14}+{'-'*12}")
        
        for epoch in range(epochs):
            # Training
            train_loss = self.train_epoch(train_loader)
            
            # Test
            test_loss = self.compute_test_loss(test_loader)
            
            # Save history
            self.history['epoch'].append(epoch + 1)
            self.history['train_loss'].append(train_loss)
            self.history['test_loss'].append(test_loss)
            
            # Format losses for display
            train_str = f"{train_loss:.6f}"
            test_str = f"{test_loss:.6f}"
            
            # Highlight best test loss
            status = ""
            if test_loss < best_test_loss:
                best_test_loss = test_loss
                status = "BEST TEST"
                # Save best model
                self.save_model('best_model.pth')
            
            # Print epoch results
            print(f"{epoch+1:^8d} | {train_str:^12} | {test_str:^12} | {status:^10}")
        
        # Save final model
        self.save_model('final_model.pth')
        print(f"\nTraining completed!")
        print(f"Best test loss: {best_test_loss:.6f} (on normalized curl)")
        
        return self.history
    
    def save_model(self, filename: str):
        """Save model checkpoint"""
        checkpoint = {
            'model_state_dict': self.model.state_dict(),
            'optimizer_state_dict': self.optimizer.state_dict(),
            'history': self.history,
            'config': self.config
        }
        
        torch.save(checkpoint, self.config.MODEL_DIR / filename)
        print(f"  Model saved to {self.config.MODEL_DIR / filename}")

