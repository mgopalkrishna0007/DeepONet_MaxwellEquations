# ========================================================================================================================================================
# COORDINATE GRID GENERATION
# ========================================================================================================================================================

# Initializes a 3D grid with variable cell sizes.
# Computes cell-centered coordinates.
# Creates 3D meshgrid arrays (X, Y, Z) for each point.
# Provides a tensor of cell sizes for all cells in [3, Nx, Ny, Nz] format.
# Useful for simulations and physics-informed neural networks where each cell may have its own dimension.

class CoordinateGrid3D:
    """Manages 3D coordinate grid generation with variable cell sizes"""
    
    def __init__(self, delta_x: float, delta_y: float, delta_z: float):
        """
        Initialize grid with specific cell dimensions.
        
        Args:
            delta_x, delta_y, delta_z: Cell dimensions in meters (0.3-0.8 mm range)
        """
        self.delta_x = delta_x
        self.delta_y = delta_y
        self.delta_z = delta_z
        
        # Generate coordinates at cell centers (N_CELLS cells)
        self.x = np.linspace(delta_x/2, Config.N_CELLS * delta_x - delta_x/2, Config.Nx)
        self.y = np.linspace(delta_y/2, Config.N_CELLS * delta_y - delta_y/2, Config.Ny)
        self.z = np.linspace(delta_z/2, Config.N_CELLS * delta_z - delta_z/2, Config.Nz)
        
        # Create meshgrid
        self.X, self.Y, self.Z = np.meshgrid(self.x, self.y, self.z, indexing='ij')
    
    def get_cell_size_tensor(self) -> np.ndarray:
        """
        Get cell size tensor for trunk network.
        
        Returns:
            cell_sizes: [3, Nx, Ny, Nz] array with cell sizes broadcasted
        """
        # Create 3D arrays by broadcasting scalar values - NO NORMALIZATION
        delta_x_array = np.full((Config.Nx, Config.Ny, Config.Nz), self.delta_x, dtype=np.float32)
        delta_y_array = np.full((Config.Nx, Config.Ny, Config.Nz), self.delta_y, dtype=np.float32)
        delta_z_array = np.full((Config.Nx, Config.Ny, Config.Nz), self.delta_z, dtype=np.float32)
        
        # Stack to create [3, Nx, Ny, Nz] tensor
        cell_sizes = np.stack([delta_x_array, delta_y_array, delta_z_array], axis=0)
        
        return cell_sizes

