class ResidualBlock3D(nn.Module):
    """Residual block with two 3x3x3 convolutions and GELU activation"""
    
    def __init__(self, in_channels: int, out_channels: int):
        super().__init__()
        
        # First convolution
        self.conv1 = nn.Conv3d(
            in_channels, out_channels, 
            kernel_size=3, stride=1, padding=1
        )
        self.gelu1 = nn.GELU()
        
        # Second convolution
        self.conv2 = nn.Conv3d(
            out_channels, out_channels, 
            kernel_size=3, stride=1, padding=1
        )
        self.gelu2 = nn.GELU()
        
        # Residual connection
        if in_channels != out_channels:
            self.residual_conv = nn.Conv3d(in_channels, out_channels, kernel_size=1)
        else:
            self.residual_conv = nn.Identity()
    
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        residual = x
        
        # First convolution + activation
        out = self.conv1(x)
        out = self.gelu1(out)
        
        # Second convolution
        out = self.conv2(out)
        
        # Residual connection
        out = out + self.residual_conv(residual)
        
        # Final activation
        out = self.gelu2(out)
        
        return out

class DownsamplingBlock(nn.Module):
    """Downsampling block with residual block and max pooling"""
    
    def __init__(self, in_channels: int, out_channels: int, is_last: bool = False):
        super().__init__()
        self.is_last = is_last
        
        # Residual block
        self.res_block = ResidualBlock3D(in_channels, out_channels)
        
        # Max pooling (except for last block)
        if not is_last:
            self.pool = nn.MaxPool3d(kernel_size=2, stride=2)
        else:
            self.pool = nn.Identity()
    
    def forward(self, x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        # Residual block
        features = self.res_block(x)
        
        # Pooling (except last)
        pooled = self.pool(features)
        
        return pooled, features

class UpsamplingBlock(nn.Module):
    """Upsampling block with transposed convolution and residual block"""
    
    def __init__(self, in_channels: int, out_channels: int, skip_channels: int):
        super().__init__()
        
        # Transposed convolution for upsampling
        self.upconv = nn.ConvTranspose3d(
            in_channels, out_channels, 
            kernel_size=2, stride=2
        )
        
        # Residual block (input is concatenated with skip connection)
        self.res_block = ResidualBlock3D(out_channels + skip_channels, out_channels)
    
    def forward(self, x: torch.Tensor, skip: torch.Tensor) -> torch.Tensor:
        # Upsample
        x = self.upconv(x)
        
        # Concatenate with skip connection
        x = torch.cat([x, skip], dim=1)
        
        # Residual block
        x = self.res_block(x)
        
        return x

class DCO_UNet3D(nn.Module):
    """
    DCO-UNet 3D architecture as per paper specifications.
    
    Features:
    1. Branch network processes E-field
    2. Trunk network processes cell sizes
    3. Hadamard product only at bottleneck
    4. Skip connections between corresponding blocks
    5. Outputs raw curl (no normalization)
    """
    
    def __init__(self, branch_in_channels: int = 3, trunk_in_channels: int = 3,
                 out_channels: int = 3, init_channels: int = 32, num_levels: int = 4):
        super().__init__()
        
        self.num_levels = num_levels
        
        # Branch Network (E-field processing)
        self.branch_down_blocks = nn.ModuleList()
        self.branch_skip_features = []  # Store skip connections
        
        # First branch down block
        self.branch_down_blocks.append(
            DownsamplingBlock(branch_in_channels, init_channels)
        )
        
        # Remaining branch down blocks
        for i in range(1, num_levels):
            in_ch = init_channels * (2 ** (i - 1))
            out_ch = init_channels * (2 ** i)
            is_last = (i == num_levels - 1)
            self.branch_down_blocks.append(
                DownsamplingBlock(in_ch, out_ch, is_last)
            )
        
        # Trunk Network (Cell size processing)
        self.trunk_down_blocks = nn.ModuleList()
        
        # First trunk down block
        self.trunk_down_blocks.append(
            DownsamplingBlock(trunk_in_channels, init_channels)
        )
        
        # Remaining trunk down blocks
        for i in range(1, num_levels):
            in_ch = init_channels * (2 ** (i - 1))
            out_ch = init_channels * (2 ** i)
            is_last = (i == num_levels - 1)
            self.trunk_down_blocks.append(
                DownsamplingBlock(in_ch, out_ch, is_last)
            )
        
        # Bottleneck - Hadamard product
        bottleneck_channels = init_channels * (2 ** (num_levels - 1))
        self.bottleneck_res_block = ResidualBlock3D(bottleneck_channels, bottleneck_channels)
        
        # Upsampling blocks - FIXED: using range(num_levels - 2, -1, -1)
        self.up_blocks = nn.ModuleList()
        
        # First up block (from bottleneck to second-to-last level)
        in_ch = bottleneck_channels
        out_ch = init_channels * (2 ** (num_levels - 2))
        skip_ch = init_channels * (2 ** (num_levels - 2))
        self.up_blocks.append(
            UpsamplingBlock(in_ch, out_ch, skip_ch)
        )
        
        # Remaining up blocks
        for i in range(num_levels - 2, 0, -1):
            in_ch = init_channels * (2 ** i)
            out_ch = init_channels * (2 ** (i - 1))
            skip_ch = init_channels * (2 ** (i - 1))
            self.up_blocks.append(
                UpsamplingBlock(in_ch, out_ch, skip_ch)
            )
        
        # Final convolution to output channels
        self.final_conv = nn.Conv3d(
            init_channels, out_channels, 
            kernel_size=1, stride=1
        )
        
        # Initialize weights
        self._initialize_weights()
    
    def _initialize_weights(self):
        """Initialize model weights"""
        for m in self.modules():
            if isinstance(m, nn.Conv3d) or isinstance(m, nn.ConvTranspose3d):
                nn.init.kaiming_normal_(m.weight, mode='fan_out', nonlinearity='relu')
                if m.bias is not None:
                    nn.init.constant_(m.bias, 0)
    
    def forward(self, branch_input: torch.Tensor, trunk_input: torch.Tensor) -> torch.Tensor:
        """
        Forward pass of DCO-UNet.
        
        Args:
            branch_input: E-field tensor [B, 3, Nx, Ny, Nz]
            trunk_input: Cell size tensor [B, 3, Nx, Ny, Nz]
            
        Returns:
            curl_pred: Predicted curl tensor [B, 3, Nx, Ny, Nz] (raw, not normalized)
        """
        # Clear skip features from previous forward pass
        self.branch_skip_features = []
        
        # Branch network forward pass (store skip connections)
        x_branch = branch_input
        for i, block in enumerate(self.branch_down_blocks):
            x_branch, skip_features = block(x_branch)
            # Store skip connections from all levels except the last
            if i < self.num_levels - 1:
                self.branch_skip_features.append(skip_features)
        
        # Trunk network forward pass
        x_trunk = trunk_input
        for block in self.trunk_down_blocks:
            x_trunk, _ = block(x_trunk)
        
        # Bottleneck: Hadamard product (element-wise multiplication) - ONLY AT BOTTLENECK
        x_bottleneck = x_branch * x_trunk
        
        # Bottleneck residual block
        x_bottleneck = self.bottleneck_res_block(x_bottleneck)
        
        # Upsampling with skip connections (in reverse order)
        x_up = x_bottleneck
        for i, up_block in enumerate(self.up_blocks):
            skip = self.branch_skip_features[-(i + 1)]  # Get skip in reverse order
            x_up = up_block(x_up, skip)
        
        # Final convolution - outputs raw curl
        curl_pred = self.final_conv(x_up)
        
        return curl_pred

