class LocalMaxNormalizer3D:
    """Normalize curl by local maximum for each component"""
    
    @staticmethod
    def normalize_with_scale(curl: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
        """
        Normalize curl by local maximum for each component.
        
        Args:
            curl: [3, Nx, Ny, Nz] curl array
            
        Returns:
            curl_norm: Normalized curl (each component divided by its max)
            scale: [3,] array of max values for each component
        """
        curl_norm = np.zeros_like(curl, dtype=np.float32)
        scale = np.zeros(3, dtype=np.float32)
        
        for i in range(3):
            # Find maximum absolute value for this component
            max_val = np.max(np.abs(curl[i]))
            if max_val > 1e-8:
                curl_norm[i] = curl[i] / max_val
                scale[i] = max_val
            else:
                curl_norm[i] = curl[i]
                scale[i] = 1.0
        
        return curl_norm, scale
    
    @staticmethod
    def normalize_tensor_with_scale(curl_tensor: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        """
        Normalize curl tensor by local maximum for each component.
        
        Args:
            curl_tensor: [B, 3, Nx, Ny, Nz] curl tensor
            
        Returns:
            curl_norm: Normalized curl tensor
            scale: [B, 3] tensor of max values for each component
        """
        batch_size = curl_tensor.shape[0]
        curl_norm = torch.zeros_like(curl_tensor)
        scale = torch.zeros(batch_size, 3, device=curl_tensor.device)
        
        for b in range(batch_size):
            for i in range(3):
                # Find maximum absolute value for this component
                max_val = torch.max(torch.abs(curl_tensor[b, i]))
                if max_val > 1e-8:
                    curl_norm[b, i] = curl_tensor[b, i] / max_val
                    scale[b, i] = max_val
                else:
                    curl_norm[b, i] = curl_tensor[b, i]
                    scale[b, i] = 1.0
        
        return curl_norm, scale

# ========================================================================================================================================================
# PHYSICS: PLANE WAVE GENERATION
# ========================================================================================================================================================

# Purpose: Generate 3D plane waves and their superpositions for physics-informed simulations.
# Three methods:
# generate_wave_parameters → random θ, φ, k, amplitudes for all waves.
# generate_single_wave → compute a single plane wave E-field using divergence-free condition.
# generate_wave_superposition → sum multiple plane waves to create a complex field.
# Uses grid coordinates from CoordinateGrid3D and Config for parameters.
# Returns 3D arrays of E-field components [Ex, Ey, Ez].

class PlaneWaveGenerator3D:
    """Generates plane wave superpositions as per paper specifications"""
    
    @staticmethod
    def generate_wave_parameters(num_waves: int = Config.NUM_WAVES) -> Dict[str, Any]:
        """
        Generate wave parameters as per paper.
        
        Returns:
            Dictionary with wave parameters
        """
        # Single theta and phi for all waves in this sample
        theta = np.random.uniform(0, np.pi)
        phi = np.random.uniform(-np.pi, np.pi)
        
        # Multiple k values (n=20)
        k_values = np.random.uniform(Config.K_MIN, Config.K_MAX, num_waves)
        
        # Random amplitudes for Ex and Ey
        Ex0_values = np.random.uniform(*Config.AMPLITUDE_RANGE, num_waves)
        Ey0_values = np.random.uniform(*Config.AMPLITUDE_RANGE, num_waves)
        
        return {
            'theta': theta,
            'phi': phi,
            'k_values': k_values,
            'Ex0': Ex0_values,
            'Ey0': Ey0_values
        }
    
    @staticmethod
    def generate_single_wave(grid: CoordinateGrid3D, theta: float, phi: float, 
                           k: float, Ex0: float, Ey0: float) -> np.ndarray:
        """
        Generate a single plane wave.
        
        E_i = E0,i exp[-j k_i (x cosφ sinθ + y sinφ sinθ + z cosθ)]
        
        Returns:
            E: [3, Nx, Ny, Nz] array of E-field components (real part)
        """
        # Wave vector components
        kx = k * np.sin(theta) * np.cos(phi)
        ky = k * np.sin(theta) * np.sin(phi)
        kz = k * np.cos(theta)
        
        # Calculate Ez0 from divergence-free condition (∇·E = 0)
        # k·E = 0 => kx*Ex0 + ky*Ey0 + kz*Ez0 = 0
        if np.abs(kz) > 1e-10:
            Ez0 = -(kx * Ex0 + ky * Ey0) / kz
        else:
            # Handle case where wave propagates perpendicular to z
            Ez0 = 0.0
        
        # Phase term: k·r = kx*x + ky*y + kz*z
        phase = kx * grid.X + ky * grid.Y + kz * grid.Z
        
        # Complex exponential (using Euler's formula for real part)
        E = np.zeros((3, Config.Nx, Config.Ny, Config.Nz), dtype=np.float32)
        E[0] = Ex0 * np.cos(phase)
        E[1] = Ey0 * np.cos(phase)
        E[2] = Ez0 * np.cos(phase)
        
        return E
    
    @staticmethod
    def generate_wave_superposition(grid: CoordinateGrid3D, 
                                  num_waves: int = Config.NUM_WAVES) -> Tuple[np.ndarray, Dict[str, Any]]:
        """
        Generate superposition of multiple plane waves.
        
        E = Σ_{i=0}^{n} E0,i exp[-j k_i (x cosφ_i sinθ_i + y sinφ_i sinθ_i + z cosθ_i)]
        
        Returns:
            E_total: Superposed E-field [3, Nx, Ny, Nz]
            params: Wave parameters dictionary
        """
        # Generate parameters for this sample
        params = PlaneWaveGenerator3D.generate_wave_parameters(num_waves)
        
        # Initialize total E-field
        E_total = np.zeros((3, Config.Nx, Config.Ny, Config.Nz), dtype=np.float32)
        
        # Superposition of waves
        for i in range(num_waves):
            E_wave = PlaneWaveGenerator3D.generate_single_wave(
                grid, params['theta'], params['phi'],
                params['k_values'][i], params['Ex0'][i], params['Ey0'][i]
            )
            E_total += E_wave
        
        return E_total, params

# ========================================================================================================================================================
# ANALYTICAL CURL COMPUTATION
# ========================================================================================================================================================

class AnalyticalCurlCalculator:
    """Computes analytic curl for wave superpositions using k × E identity"""
    
    @staticmethod
    def compute_curl_for_superposition(grid: CoordinateGrid3D, params: Dict[str, Any]) -> np.ndarray:
        """
        Compute analytic curl ∇ × E for plane wave superposition.
        
        For a plane wave E = E0 cos(k·r), we have:
        ∇ × E = -k × E0 sin(k·r)
        
        Returns:
            curl_total: [3, Nx, Ny, Nz] curl components
        """
        theta = params['theta']
        phi = params['phi']
        k_values = params['k_values']
        Ex0 = params['Ex0']
        Ey0 = params['Ey0']
        num_waves = len(k_values)
        
        curl_total = np.zeros((3, Config.Nx, Config.Ny, Config.Nz), dtype=np.float32)
        
        # Wave vector components (same for all k values since theta, phi fixed)
        sin_theta = np.sin(theta)
        cos_theta = np.cos(theta)
        cos_phi = np.cos(phi)
        sin_phi = np.sin(phi)
        
        for i in range(num_waves):
            k = k_values[i]
            
            # Wave vector
            kx = k * sin_theta * cos_phi
            ky = k * sin_theta * sin_phi
            kz = k * cos_theta
            
            # Calculate Ez0 from divergence-free condition
            if np.abs(kz) > 1e-10:
                Ez0 = -(kx * Ex0[i] + ky * Ey0[i]) / kz
            else:
                Ez0 = 0.0
            
            # Phase term
            phase = kx * grid.X + ky * grid.Y + kz * grid.Z
            sin_phase = np.sin(phase)
            
            # Cross product: k × E0
            # Note: For E = E0 cos(k·r), ∇ × E = -k × E0 sin(k·r)
            curl_x = ky * Ez0 - kz * Ey0[i]
            curl_y = kz * Ex0[i] - kx * Ez0
            curl_z = kx * Ey0[i] - ky * Ex0[i]
            
            # Multiply by -sin(k·r) and add to total
            curl_total[0] -= curl_x * sin_phase
            curl_total[1] -= curl_y * sin_phase
            curl_total[2] -= curl_z * sin_phase
        
        return curl_total

